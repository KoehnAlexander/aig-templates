	language = "English",
	isbn = "978-1-956792-00-3",
	pages = "2655--2661",
	editor = "{De Raedt}, Luc",
	booktitle = "Proceedings of the Thirty-First International Joint Conference on Artificial Intelligence, IJCAI 2022, Vienna, Austria, 23-29 July 2022",
	publisher = "ijcai.org",
}

